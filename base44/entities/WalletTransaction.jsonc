{
  "name": "WalletTransaction",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the wallet owner"
    },
    "type": {
      "type": "string",
      "enum": [
        "credit",
        "debit",
        "withdrawal"
      ],
      "description": "Transaction type"
    },
    "amount": {
      "type": "number",
      "description": "Amount in Naira"
    },
    "description": {
      "type": "string",
      "description": "Transaction description"
    },
    "reference": {
      "type": "string",
      "description": "Unique reference"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed"
      ],
      "default": "completed"
    },
    "bank_name": {
      "type": "string",
      "description": "Bank name for withdrawals"
    },
    "bank_account": {
      "type": "string",
      "description": "Bank account number for withdrawals"
    }
  },
  "required": [
    "user_email",
    "type",
    "amount"
  ]
}