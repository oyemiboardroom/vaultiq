{
  "name": "StressTest",
  "type": "object",
  "properties": {
    "scenario_name": {
      "type": "string"
    },
    "pnl_impact": {
      "type": "number",
      "description": "P&L impact in Naira"
    },
    "pnl_percent": {
      "type": "number",
      "description": "Impact as percentage of AUM"
    },
    "severity": {
      "type": "string",
      "enum": [
        "positive",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    }
  },
  "required": [
    "scenario_name"
  ]
}